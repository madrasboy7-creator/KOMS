# Server Port (Render automatically sets PORT=10000)
PORT=5000

# Node Environment
NODE_ENV=production

# Neon Serverless PostgreSQL Database Connection String
# Get this from Neon Dashboard (https://console.neon.tech) -> Connection Details -> Pooled connection
# Example: postgresql://neondb_owner:npg_xxxx@ep-cool-mountain-a5xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT Secret for Master & Instructor Authentication
JWT_SECRET=koms_super_secret_jwt_key_dojo_master_2026
