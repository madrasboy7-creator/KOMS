# =============================================================================
# KOMS: Karate Organization Management System — Environment Configuration
# =============================================================================

# Server Port (Render automatically sets PORT=10000)
PORT=5000

# Node Environment
NODE_ENV=production

# Supabase PostgreSQL Database Connection String
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Pooled)
# Example: postgresql://postgres.xxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Supabase API Credentials (Optional - for Supabase client usage)
# Get from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret for Master & Instructor Authentication
JWT_SECRET=koms_super_secret_jwt_key_dojo_master_2026

